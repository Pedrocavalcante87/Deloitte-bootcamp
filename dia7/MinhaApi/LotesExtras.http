### Variáveis
@baseUrl = http://localhost:5247
@loteId = 1

###############################################
# ENDPOINTS EXTRAS DE LOTES
###############################################

### 1. GET - Classificação de Qualidade
GET {{baseUrl}}/api/lotes/{{loteId}}/classificacao

### 2. GET - Preço por Tonelada
GET {{baseUrl}}/api/lotes/{{loteId}}/preco

### 3. GET - Penalidade por Umidade
GET {{baseUrl}}/api/lotes/{{loteId}}/penalidade-umidade

### 4. POST - Adicionar Histórico de Movimentação
POST {{baseUrl}}/api/lotes/{{loteId}}/movimentacao?localDestino=Porto de Tubarão

### 5. POST - Avançar Status do Lote (Primeira vez: EmEstoque → EmTransporte)
POST {{baseUrl}}/api/lotes/{{loteId}}/avancar-status

### 6. POST - Avançar Status do Lote (Segunda vez: EmTransporte → Embarcado)
POST {{baseUrl}}/api/lotes/{{loteId}}/avancar-status

### 7. POST - Avançar Status do Lote (Terceira vez: já está Embarcado)
POST {{baseUrl}}/api/lotes/{{loteId}}/avancar-status

###############################################
# CRUD ORIGINAL (para criar lote de teste)
###############################################

### Criar um lote de teste
POST {{baseUrl}}/api/LotesMinerio
Content-Type: application/json

{
  "codigoLote": "TEST-2026-001",
  "minaOrigem": "Carajás",
  "teorFe": 68.5,
  "umidade": 7.2,
  "siO2": 1.8,
  "toneladas": 15000,
  "status": 0,
  "localizacaoAtual": "Mina Carajás"
}

### Listar todos os lotes
GET {{baseUrl}}/api/LotesMinerio

### Buscar lote por ID
GET {{baseUrl}}/api/LotesMinerio/{{loteId}}
